DATABASE_URL=postgresql+asyncpg://parsing:parsing@postgres:5432/parsing
GOLDENPAGES_BASE_URL=https://www.goldenpages.uz
YELLOWPAGES_BASE_URL=https://www.yellowpages.uz
SECRET_KEY=change-me-too

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_FULL_NAME=Administrator
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Scraping (all optional, shown with their defaults) ---
# Seconds between requests. Raise this if a source starts returning 429 --
# staying under the limit is far more effective than reacting to it.
SCRAPER_REQUEST_DELAY_SECONDS=1.0
# Per-request retries (exponential backoff + jitter, honours Retry-After).
SCRAPER_MAX_RETRIES=4
SCRAPER_BACKOFF_BASE_SECONDS=2.0
SCRAPER_BACKOFF_MAX_SECONDS=120.0
# Consecutive per-item failures tolerated before the whole run aborts.
# Isolated failures are always skipped and counted, never fatal.
SCRAPER_MAX_CONSECUTIVE_FAILURES=25
# Optional outbound proxies, comma-separated, rotated per request. Empty means
# a direct connection (the default). Only worth setting with proxies you own or
# pay for -- free public proxy lists are mostly dead/slow and make runs *less*
# reliable, not more.
# SCRAPER_PROXIES=http://user:pass@host:8080,socks5://host:1080
SCRAPER_PROXIES=
